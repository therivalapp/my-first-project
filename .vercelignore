# Vercel only reads the ignore file at the repo ROOT, and this repo's root
# .gitignore does not cover rival/node_modules — so a CLI deploy from here
# tried to upload ~600MB of dependencies and aborted mid-upload. Vercel
# installs dependencies itself (Root Directory is "rival"), so none of this
# needs to travel.
node_modules
**/node_modules

# Build output — regenerated by the build on Vercel.
dist
**/dist
.expo
**/.expo

# Local-only scratch: a 17MB snapshot of an older web build kept for
# before/after comparison.
dist-before
**/dist-before

.git
